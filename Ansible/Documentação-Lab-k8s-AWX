6.6 Acessar o AWX
bash
# Descobrir a porta
kubectl get svc -n awx awx-service

# Obter a senha do admin
kubectl get secret awx-admin-password -n awx -o jsonpath="{.data.password}" | base64 --decode && echo

# Comando para exibir URL completa
